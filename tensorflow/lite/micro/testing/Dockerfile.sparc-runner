# ==============================================================================
#
# Minimal NATIVE-architecture image that only runs SPARC ELF binaries under
# qemu user-mode. It is intentionally NOT pinned to a platform: on Apple
# Silicon it builds as arm64 so qemu-sparc64 emulates SPARC directly (single
# emulation, fast), avoiding the Rosetta+TCG double emulation that occurs when
# qemu runs inside the amd64 toolchain image.
#
# Used by tensorflow/lite/micro/testing/sparc_docker_test.sh together with the
# amd64 build image (Dockerfile.sparc).

FROM debian:bookworm-backports

RUN echo "deb http://deb.debian.org/debian bookworm-backports main" \
        > /etc/apt/sources.list.d/backports.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends -t bookworm-backports qemu-user && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/tflm
